# syntax=docker/dockerfile:1
FROM mambaorg/micromamba:ubuntu24.04

USER root
RUN apt-get update && \
  apt-get install -yq --no-install-recommends ca-certificates tzdata && \
  ln -fs /usr/share/zoneinfo/Europe/Berlin /etc/localtime && \
  dpkg-reconfigure -f noninteractive tzdata && \
  mkdir -p /refdata/gtdbtk /refdata/checkm
USER $MAMBA_USER

RUN <<EOF cat > mgs-lr-processing.yml
name: mgs-lr-processing
channels:
  - conda-forge
  - bioconda
dependencies:
  - python=3.11
  - pandas=1.5.3
  - seaborn=0.12.2
  - myloasm=0.6.0
  - semibin=2.2.0
  - metabat2=2.17
  - das_tool=1.1.7
  - gtdbtk=2.6.1
  - checkm-genome=1.2.4
  - pip
EOF

RUN micromamba install -y -n base -f mgs-lr-processing.yml && \
  micromamba clean --all --yes

ENV PATH="/opt/conda/bin:$PATH"

# databases are supplied at runtime (GTDBTK_DATA_PATH / CHECKM_DATA_PATH),
# caches have to be writable in a read-only singularity image
ENV GTDBTK_DATA_PATH="/refdata/gtdbtk" \
  CHECKM_DATA_PATH="/refdata/checkm" \
  MPLCONFIGDIR="/tmp/matplotlib" \
  NUMBA_CACHE_DIR="/tmp/numba" \
  XDG_CACHE_HOME="/tmp/cache"
